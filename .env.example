# Server Configuration
PORT=8080
GIN_MODE=release
LOG_LEVEL=info

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=ai_backend
DB_PASSWORD=ai_backend_password
DB_NAME=ai_backend
DB_SSLMODE=disable

# API Keys (REQUIRED)
ELEVENLABS_API_KEY=your_key_here
LUMA_API_KEY=your_key_here
KLING_API_KEY=your_key_here
FAL_API_KEY=your_fal_ai_key_here
OPENAI_API_KEY=your_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
XAI_API_KEY=

# Provider Base URLs (optional — override for mock server)
# ANTHROPIC_BASE_URL=http://localhost:9999

# HTTP Settings
HTTP_TIMEOUT=300
HTTP_RETRY_MAX=3
HTTP_RETRY_WAIT=2

# Job Settings
JOB_EXPIRATION_HOURS=24
JOB_CLEANUP_INTERVAL=60

# Output Settings
OUTPUT_DIR=./outputs

# CORS
CORS_ALLOW_ORIGINS=http://localhost:*

# Telemetry
OTEL_METRICS_EXPORTER=          # "stdout" | "otlp" | "prometheus" | "" (disabled)
OTEL_TRACES_EXPORTER=           # "otlp" | "" (disabled)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4319
OTEL_SERVICE_NAME=ai-providers-backend

MCP_AUTH_TOKEN=test-token-local
MCP_LISTEN_ADDR=:8081

# OIDC / OAuth 2.1 (for MCP remote server)
OIDC_ENABLED=false                     # "true" to use OIDC instead of static token
OIDC_ISSUER_URL=                       # Auth0 tenant URL, e.g., https://YOUR_TENANT.us.auth0.com
OIDC_AUDIENCE=                         # Auth0 API identifier, e.g., https://mcp.laguna-escondida.com
MCP_CANONICAL_URL=                     # Public URL of this MCP server, e.g., https://mcp-remote.up.railway.app

DATABASE_URL=postgres://ai_backend:ai_backend_password@localhost:5432/ai_backend?sslmode=disable
