# Mock server configuration
# Point all providers to the local mock server
ELEVENLABS_BASE_URL=http://localhost:9999
FAL_BASE_URL=http://localhost:9999
OPENAI_BASE_URL=http://localhost:9999
LUMA_BASE_URL=http://localhost:9999
ANTHROPIC_BASE_URL=http://localhost:9999

# API keys (mock server ignores these, but config validation requires them)
ELEVENLABS_API_KEY=mock-key
FAL_API_KEY=mock-key
OPENAI_API_KEY=mock-key
LUMA_API_KEY=mock-key
ANTHROPIC_API_KEY=mock-key

# Mock server error injection
MOCK_PORT=9999
MOCK_ERROR_RATE=0.1
MOCK_ERROR_429_RATE=0.1
MOCK_ERROR_500_RATE=0.03
MOCK_LATENCY_MIN_MS=10
MOCK_LATENCY_MAX_MS=200
MOCK_POLL_STEPS=2
